{
    "name": "morte-library",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "docker compose up -d --build db api && vite site",
        "db:generate": "drizzle-kit generate --config api/drizzle.config.ts",
        "build": "tsc --noEmit -p site && vite build site",
        "preview": "vite preview site",
        "server": "bun run api/index.ts",
        "lint": "biome check .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "drizzle-orm": "^0.45.4",
        "mysql2": "^3.22.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.0.0",
        "@jsquash/avif": "2.1.1",
        "@types/bun": "^1.3.14",
        "@types/react": "^19.1.10",
        "@types/react-dom": "^19.1.7",
        "@types/three": "0.186.0",
        "@vitejs/plugin-react": "^5.0.0",
        "drizzle-kit": "^0.31.11",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router": "^8.5.0",
        "sass": "^1.91.0",
        "three": "0.186.1",
        "typescript": "~5.8.3",
        "vite": "^7.1.2"
    }
}
